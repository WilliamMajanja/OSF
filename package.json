{
  "name": "opencode-skill-forge",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Local OpenCode skill studio: 25 no-generation templates, validate/install skills, and tidy docs safely.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamMajanja/OSF.git"
  },
  "homepage": "https://github.com/WilliamMajanja/OSF#readme",
  "bugs": {
    "url": "https://github.com/WilliamMajanja/OSF/issues"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
